generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USUARIOS Y AUTENTICACIÓN
// ─────────────────────────────────────────────

enum Rol {
  ADMIN
  OPERADOR
  CLIENTE
}

model Usuario {
  id         Int      @id @default(autoincrement())
  nombre     String
  email      String   @unique
  password   String
  rol        Rol      @default(CLIENTE)
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cliente    Cliente?
  operador   Operador?
  cajas      Caja[]
  movimientos Movimiento[]

  @@map("usuarios")
}

model Cliente {
  id          Int      @id @default(autoincrement())
  usuario_id  Int      @unique
  telefono    String?
  direccion   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  usuario     Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  pedidos     Pedido[]
  ventas      Venta[]

  @@map("clientes")
}

model Operador {
  id         Int      @id @default(autoincrement())
  usuario_id Int      @unique
  created_at DateTime @default(now())

  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("operadores")
}

// ─────────────────────────────────────────────
// CATÁLOGO
// ─────────────────────────────────────────────

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  imagen      String?
  icono       String?
  activa      Boolean    @default(true)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  productos   Producto[]

  @@map("categorias")
}

model Producto {
  id           Int        @id @default(autoincrement())
  nombre       String
  descripcion  String?
  precio       Decimal    @db.Decimal(10, 2)
  precio_oferta Decimal?  @db.Decimal(10, 2)
  stock        Int        @default(0)
  stock_minimo Int        @default(5)
  imagen       String?
  marca        String?
  codigo       String?    @unique
  activo       Boolean    @default(true)
  destacado    Boolean    @default(false)
  categoria_id Int?
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  categoria    Categoria? @relation(fields: [categoria_id], references: [id])
  carrito_items CarritoItem[]
  detalle_pedidos DetallePedido[]
  detalle_ventas  DetalleVenta[]
  detalle_ordenes DetalleOrdenCompra[]
  movimientos  Movimiento[]
  descuentos   DescuentoProducto[]

  @@map("productos")
}

// ─────────────────────────────────────────────
// CARRITO (sesiones anónimas + clientes)
// ─────────────────────────────────────────────

model Carrito {
  id         Int      @id @default(autoincrement())
  session_id String   @unique
  cliente_id Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items      CarritoItem[]

  @@map("carritos")
}

model CarritoItem {
  id          Int      @id @default(autoincrement())
  carrito_id  Int
  producto_id Int
  cantidad    Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  carrito     Carrito  @relation(fields: [carrito_id], references: [id], onDelete: Cascade)
  producto    Producto @relation(fields: [producto_id], references: [id])

  @@unique([carrito_id, producto_id])
  @@map("carrito_items")
}

// ─────────────────────────────────────────────
// PEDIDOS (e-commerce — clientes)
// ─────────────────────────────────────────────

enum EstadoPedido {
  PENDIENTE_CONFIRMACION
  CONFIRMADO
  EN_RUTA
  ENTREGADO
  CANCELADO
}

model Pedido {
  id                Int          @id @default(autoincrement())
  cliente_id        Int?
  nombre_invitado   String?
  telefono_invitado String?
  email_invitado    String?
  direccion_entrega String
  observaciones     String?
  total             Decimal      @db.Decimal(10, 2)
  estado            EstadoPedido @default(PENDIENTE_CONFIRMACION)
  confirmado_whatsapp Boolean    @default(false)
  expires_at        DateTime?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  cliente           Cliente?     @relation(fields: [cliente_id], references: [id])
  detalle_pedido    DetallePedido[]

  @@map("pedidos")
}

model DetallePedido {
  id           Int      @id @default(autoincrement())
  pedido_id    Int
  producto_id  Int
  cantidad     Int
  precio_unit  Decimal  @db.Decimal(10, 2)
  subtotal     Decimal  @db.Decimal(10, 2)

  pedido       Pedido   @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  productos    Producto @relation(fields: [producto_id], references: [id])

  @@map("detalle_pedidos")
}

// ─────────────────────────────────────────────
// VENTAS (punto de venta presencial — operador/admin)
// ─────────────────────────────────────────────

enum EstadoVenta {
  COMPLETADA
  CANCELADA
  PENDIENTE
}

model Venta {
  id           Int         @id @default(autoincrement())
  cliente_id   Int?
  caja_id      Int?
  total        Decimal     @db.Decimal(10, 2)
  descuento    Decimal     @default(0) @db.Decimal(10, 2)
  estado       EstadoVenta @default(COMPLETADA)
  observaciones String?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  cliente      Cliente?    @relation(fields: [cliente_id], references: [id])
  caja         Caja?       @relation(fields: [caja_id], references: [id])
  detalle      DetalleVenta[]

  @@map("ventas")
}

model DetalleVenta {
  id          Int      @id @default(autoincrement())
  venta_id    Int
  producto_id Int
  cantidad    Int
  precio_unit Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  venta       Venta    @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  producto    Producto @relation(fields: [producto_id], references: [id])

  @@map("detalle_ventas")
}

// ─────────────────────────────────────────────
// CAJA
// ─────────────────────────────────────────────

enum EstadoCaja {
  ABIERTA
  CERRADA
}

model Caja {
  id             Int        @id @default(autoincrement())
  usuario_id     Int
  monto_apertura Decimal    @db.Decimal(10, 2)
  monto_cierre   Decimal?   @db.Decimal(10, 2)
  total_ventas   Decimal    @default(0) @db.Decimal(10, 2)
  estado         EstadoCaja @default(ABIERTA)
  abierta_at     DateTime   @default(now())
  cerrada_at     DateTime?

  usuario        Usuario    @relation(fields: [usuario_id], references: [id])
  ventas         Venta[]

  @@map("cajas")
}

// ─────────────────────────────────────────────
// PROVEEDORES Y ÓRDENES DE COMPRA
// ─────────────────────────────────────────────

model Proveedor {
  id         Int      @id @default(autoincrement())
  nombre     String
  contacto   String?
  telefono   String?
  email      String?
  direccion  String?
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  ordenes    OrdenCompra[]

  @@map("proveedores")
}

enum EstadoOrden {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

model OrdenCompra {
  id           Int         @id @default(autoincrement())
  proveedor_id Int
  total        Decimal     @db.Decimal(10, 2)
  estado       EstadoOrden @default(PENDIENTE)
  notas        String?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  recibida_at  DateTime?

  proveedor    Proveedor   @relation(fields: [proveedor_id], references: [id])
  detalle      DetalleOrdenCompra[]

  @@map("ordenes_compra")
}

model DetalleOrdenCompra {
  id           Int         @id @default(autoincrement())
  orden_id     Int
  producto_id  Int
  cantidad     Int
  precio_unit  Decimal     @db.Decimal(10, 2)
  cantidad_recibida Int    @default(0)

  orden        OrdenCompra @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  producto     Producto    @relation(fields: [producto_id], references: [id])

  @@map("detalle_ordenes_compra")
}

// ─────────────────────────────────────────────
// MOVIMIENTOS DE INVENTARIO
// ─────────────────────────────────────────────

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

model Movimiento {
  id          Int            @id @default(autoincrement())
  producto_id Int
  usuario_id  Int?
  tipo        TipoMovimiento
  cantidad    Int
  stock_antes Int
  stock_despues Int
  motivo      String?
  created_at  DateTime       @default(now())

  producto    Producto       @relation(fields: [producto_id], references: [id])
  usuario     Usuario?       @relation(fields: [usuario_id], references: [id])

  @@map("movimientos")
}

// ─────────────────────────────────────────────
// DESCUENTOS
// ─────────────────────────────────────────────

enum TipoDescuento {
  PORCENTAJE
  MONTO_FIJO
}

model Descuento {
  id          Int           @id @default(autoincrement())
  nombre      String
  tipo        TipoDescuento
  valor       Decimal       @db.Decimal(10, 2)
  minimo      Decimal?      @db.Decimal(10, 2)
  primera_compra Boolean    @default(false)
  activo      Boolean       @default(true)
  inicio      DateTime?
  fin         DateTime?
  created_at  DateTime      @default(now())

  productos   DescuentoProducto[]

  @@map("descuentos")
}

model DescuentoProducto {
  descuento_id Int
  producto_id  Int

  descuento    Descuento @relation(fields: [descuento_id], references: [id], onDelete: Cascade)
  producto     Producto  @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@id([descuento_id, producto_id])
  @@map("descuento_productos")
}
